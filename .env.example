# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o Git.

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados ---
# sqlite = banco em arquivo (para testar no computador, não precisa instalar nada)
# postgres = PostgreSQL (produção); preencha os campos DB_* abaixo
DB_ENGINE=sqlite
DB_NAME=newbox
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
JWT_ACCESS_MINUTOS=30
JWT_REFRESH_DIAS=1

# --- E-mail ---
# Para testar: os e-mails aparecem no terminal do Django (não são enviados de verdade).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para enviar pelo Gmail: troque a linha acima por
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# e preencha abaixo. EMAIL_HOST_PASSWORD é a "senha de app" de 16 letras gerada
# no Google, NÃO a senha normal da conta. Veja o passo a passo no README.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=seu.email@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Newbox <seu.email@gmail.com>

# Endereço do site; usado no link do e-mail de redefinição de senha
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_HORAS=1

# --- Página pública ---
NEWBOX_WHATSAPP=5585999620414
NEWBOX_TELEFONE=(85) 3458-1019
NEWBOX_EMAIL=contato@newboxbrasil.com.br

# --- Contrato em PDF ---
NEWBOX_RAZAO_SOCIAL=Newbox Self Storage
NEWBOX_CNPJ=
NEWBOX_CIDADE=Fortaleza
